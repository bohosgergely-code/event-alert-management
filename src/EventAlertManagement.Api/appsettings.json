{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=eventalert.db"
  },
  "DataProtection": {
    "KeysPath": "keys"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseTls": false,
    "FromAddress": "alerts@eventalert.local",
    "FromName": "EventAlertManagement"
  },
  "Retry": {
    "MaxAttempts": 5,
    "Delays": [
      "00:01:00",
      "00:05:00",
      "00:15:00",
      "01:00:00"
    ],
    "Lease": "00:02:00"
  },
  "Auth": {
    "Issuer": "EventAlertManagement",
    "Audience": "EventAlertManagement.Web",
    "SigningKey": "",
    "AdminKey": "",
    "TokenHours": 8,
    "LoginAttemptsPerMinute": 10
  },
  "Workers": {
    "Enabled": true
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200"
    ]
  },
  "Sources": {
    "Usgs": {
      "MaxEventAge": "03:00:00"
    }
  }
}